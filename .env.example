OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
PORT=8000

# Bitrix24
B24_WEBHOOK_URL=
B24_BOT_ID=
B24_BOT_TOKEN=

# Работа со сделками: off — не читать и не писать; plan — читать и писать план
# только в журнал; apply — выполнять запись в Bitrix24. По умолчанию plan.
EAGLES_CRM_MODE=plan

# Необязательно для короткого локального теста; рекомендуется для постоянного сервера
B24_APPLICATION_TOKEN=
